{% extends 'site/base_site.html.twig' %}

{% block sidebar %}{% endblock %}

{% block panel %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 p-3 rounded bg-red-50 border border-red-200 text-sm text-red-700">{{ message|trans }}</div>
    {% endfor %}
    <div class="max-w-sm mx-auto py-8">
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
            <h1 class="text-xl font-semibold text-gray-900 mb-6">{{ 'security.reset_new_password'|trans }}</h1>
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-4">
                {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'block w-full px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-400'}}) }}
                {{ form_errors(form.plainPassword.first) }}
            </div>
            <div class="mb-6">
                {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'block w-full px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-400'}}) }}
                {{ form_errors(form.plainPassword.second) }}
            </div>
            <button type="submit" class="w-full px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:opacity-90">
                {{ 'security.reset_save'|trans }}
            </button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
