{% extends 'base.html.twig' %}

{% block body %}
<div class="flex h-screen bg-gray-100 overflow-hidden">

    {% block sidebar %}
    <aside class="w-56 bg-gray-800 flex-shrink-0 flex flex-col">
        <div class="h-14 flex items-center px-4 border-b border-gray-700">
            <a href="{{ path('admin_index') }}" class="text-white text-sm font-semibold leading-tight">{{ 'admin.panel_title'|trans }}</a>
        </div>
        <nav class="flex-1 overflow-y-auto py-2">
            <div id="react-admin-sidebar" data-items="{{ [
                { 'route': path('admin_estates'),    'label': 'admin.nav.estates'|trans },
                { 'route': path('admin_districts'),  'label': 'admin.nav.districts'|trans },
                { 'route': path('admin_users'),      'label': 'admin.nav.users'|trans },
                { 'route': path('admin_categories'), 'label': 'admin.nav.categories'|trans },
                { 'route': path('admin_comments'),   'label': 'admin.nav.comments'|trans, 'badgeUrl': '/api/admin/comments/pending-count' },
                { 'route': path('admin_items'),      'label': 'admin.nav.menu'|trans }
            ]|json_encode }}"></div>
        </nav>
    </aside>
    {% endblock sidebar %}

    <div class="flex-1 flex flex-col overflow-hidden">
        <header class="h-14 bg-white border-b border-gray-200 flex items-center justify-end px-6 flex-shrink-0 gap-4">
            <a href="{{ path('homepage') }}" class="text-sm text-gray-600 hover:text-gray-900">{{ 'admin.go_to_site'|trans }}</a>
            <a href="{{ path('logout') }}" class="text-sm text-gray-600 hover:text-gray-900">{{ 'security.logout'|trans }}</a>
        </header>
        <main class="flex-1 overflow-auto p-6">
            {% block panel %}{% endblock %}
        </main>
    </div>

</div>
{% endblock body %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin') }}
{% endblock javascripts %}
