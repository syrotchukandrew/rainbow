{% extends 'admin/base_admin.html.twig' %}

{% block panel %}
    <div class="space-y-6">
        {% for estate in pagination %}
            <div class="bg-white border border-gray-200 rounded-lg p-4">
                <h2 class="text-lg font-medium text-gray-900 mb-3">
                    <a href="{{ path('show_estate', { 'slug': estate.slug }) }}" class="hover:underline">{{ estate.title }}</a>
                </h2>
                <div class="flex gap-3 mb-3">
                    <img src="{{ asset("#{estate.files[0].path}") }}" class="w-48 h-32 object-cover rounded" alt="">
                    {% if estate.files[3] is defined %}
                        <img src="{{ asset("#{estate.files[3].path}") }}" class="w-48 h-32 object-cover rounded" alt="">
                    {% endif %}
                </div>
                <h3 class="text-sm font-medium text-gray-700 mb-1">{{ 'site.summary'|trans }}</h3>
                <p class="text-sm text-gray-600">{{ estate.description }}</p>
            </div>
        {% endfor %}
    </div>
{% endblock panel %}
