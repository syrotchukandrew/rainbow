{% extends 'admin/base_admin.html.twig' %}

{% block panel %}
    <h1 class="text-xl font-semibold text-gray-900 mb-6">Додати об'єкт</h1>
    <div class="bg-white border border-gray-200 rounded-lg p-6 max-w-2xl">
        {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.description) }}
        {{ form_row(form.imageFile) }}
        {{ form_row(form.district) }}
        {{ form_row(form.category) }}
        {{ form_row(form.exclusive) }}
        {{ form_row(form.floor) }}
        {{ form_row(form.price) }}
        <div class="flex gap-3 mt-4">
            <input type="submit" value="Створити об'єкт" class="inline-flex items-center px-3 py-2 bg-green-600 text-white rounded text-sm font-medium hover:bg-green-700 cursor-pointer"/>
            {{ form_widget(form.saveAndCreateNew, { label: 'Зберегти і створити ще', attr: { class: 'inline-flex items-center px-3 py-2 bg-green-600 text-white rounded text-sm font-medium hover:bg-green-700 cursor-pointer' } }) }}
            <a href="{{ path('admin_index') }}" class="inline-flex items-center px-3 py-2 border border-gray-300 rounded text-sm text-gray-700 bg-white hover:bg-gray-50">
                Назад до списку
            </a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
