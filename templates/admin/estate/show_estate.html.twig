{% extends 'admin/base_admin.html.twig' %}

{% block panel %}
    <h1 class="text-xl font-semibold text-gray-900 mb-6">{{ estate.title }}</h1>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden max-w-3xl">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="px-4 py-3 text-left font-medium text-gray-700 w-40">{{ 'admin.field'|trans }}</th>
                <th class="px-4 py-3 text-left font-medium text-gray-700">{{ 'admin.value'|trans }}</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.id'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.id }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.title'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.title }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.slug'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.slug }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.created_by'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.createdBy }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.created_at'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.createdAt|date("d F Y H:i:s") }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.updated_at'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.updatedAt|date("d F Y H:i:s") }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'common.description'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.description }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'common.price'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.price }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.exclusive'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.exclusive }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'common.district'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.district.title }}</td></tr>
            <tr>
                <td class="px-4 py-3 text-gray-500">{{ 'admin.main_photo'|trans }}</td>
                <td class="px-4 py-3">
                    {% if estate.files[0] %}
                        <div class="flex flex-wrap gap-2">
                            {% for foto in estate.files %}
                                <div class="text-center">
                                    <img class="w-20 h-20 object-cover rounded border border-gray-200"
                                         src="{{ asset("#{foto.path}") | imagine_filter('little') }}" alt="">
                                    {% if estate.mainFoto and foto.id == estate.mainFoto.id %}
                                        <div class="text-xs text-green-600 mt-1">Основне</div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </td>
            </tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.comments_count'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.comments|length }}</td></tr>
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.nav.categories'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.category.title|trans }}</td></tr>
            {% if estate.floor %}
            <tr><td class="px-4 py-3 text-gray-500">{{ 'admin.floor_info'|trans }}</td><td class="px-4 py-3 text-gray-900">{{ estate.floor['floor'] }} / {{ estate.floor['count_floor'] }}</td></tr>
            {% endif %}
            </tbody>
        </table>
    </div>
    <div class="flex gap-3 mt-4">
        <a href="{{ path('admin_estate_edit', { 'slug': estate.slug }) }}" class="inline-flex items-center px-3 py-2 bg-blue-600 text-white rounded text-sm font-medium hover:bg-blue-700">
            {{ 'admin.change'|trans }}
        </a>
        {{ include('admin/estate/_form.html.twig', {
            form: delete_form,
            button_label: 'admin.delete'|trans,
            button_css: 'inline-flex items-center px-3 py-2 bg-red-600 text-white rounded text-sm font-medium hover:bg-red-700 cursor-pointer',
            show_confirmation: true,
        }, with_context = false) }}
    </div>
{% endblock panel %}
