{% for link in links %}
    {% set title = link.title %}
    {% if not link.__children %}
        <li>
            <a href="{{ path('show_category', {'slug': link.title}) }}"
               class="block px-2 py-1 rounded text-[#4a3b2e] hover:bg-[#dfd8cc]">
                {{ title|trans }}
            </a>
        </li>
    {% else %}
        <li>
            <details class="group">
                <summary class="flex items-center justify-between px-2 py-1 rounded cursor-pointer text-[#4a3b2e] hover:bg-[#dfd8cc] list-none">
                    {{ title|trans }}
                    <svg aria-hidden="true" class="w-3 h-3 flex-shrink-0 transition-transform group-open:rotate-180" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </summary>
                <ul class="ml-3 mt-1 space-y-1 border-l border-[#d9d0c4] pl-2">
                    {% include "includes/menu-links.html.twig" with {'links': link.__children} %}
                </ul>
            </details>
        </li>
    {% endif %}
{% endfor %}
