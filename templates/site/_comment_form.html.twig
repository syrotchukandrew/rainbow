
{{ form_start(form, { method: 'POST', action: path('comment_new', { 'slug': estate.slug }) }) }}
<fieldset>
    <h4>Leave a Comment:</h4>
    <div class="mb-3">
        {{ form_widget(form) }}
    </div>
    <div class="mb-3">
        <button class="px-4 py-2 text-sm font-medium rounded bg-blue-600 text-white hover:bg-blue-700" type="submit">Submit</button>
    </div>
</fieldset>
{{ form_end(form) }}
