{% extends 'site/base_site.html.twig' %}
{% block panel %}
    <div id="react-search-results"
         data-category="{{ categorySlug }}"
         data-district="{{ districtSlug }}"
         data-price="{{ price }}"
         data-except-floor="{{ exceptFloor }}"
         data-locale="{{ app.request.locale }}"
         data-labels="{{ {
             loading: 'site.loading'|trans,
             error_loading: 'site.error_loading'|trans,
             no_results: 'site.no_results'|trans,
             photo_alt: 'site.photo_alt'|trans,
             description_label: 'site.description_label'|trans,
             more: 'site.more'|trans
         }|json_encode }}">
    </div>
{% endblock panel %}
