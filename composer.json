{
    "name": "acer/rainbow",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "": "src/"
        },
        "classmap": [
            "src/Kernel.php"
        ]
    },
    "require": {
        "php": ">=8.1",
        "symfony/symfony": "6.4.*",
        "doctrine/orm": "^2.11",
        "doctrine/doctrine-bundle": "^2.5",
        "symfony/monolog-bundle": "^3.7",
        "incenteev/composer-parameter-handler": "~2.0",

        "hwi/oauth-bundle":                  "^2.0",
        "stof/doctrine-extensions-bundle":   "^1.7",
        "fakerphp/faker":                    "^1.20",
        "knplabs/knp-paginator-bundle":      "^6.0",
        "liip/imagine-bundle":               "^2.6",
        "knplabs/knp-snappy-bundle":         "^1.9",
        "knplabs/knp-snappy":                "^1.4",
        "h4cc/wkhtmltopdf-amd64":            "^0.12.3",
        "mhujer/breadcrumbs-bundle":          "^1.0",
        "friendsofsymfony/jsrouting-bundle": "^3.2",
        "php-http/httplug-bundle":           "^1.19",
        "symfony/mailer": "*",
        "masterminds/html5": "^2.10",
        "doctrine/annotations": "^2.0"
    },
    "require-dev": {
        "symfony/phpunit-bridge":            "^6.4",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "phpunit/phpunit":                   "^9.5"
    },
    "scripts": {
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "platform": {
            "php": "8.1.0"
        },
        "audit": {
            "abandoned": "ignore",
            "block-insecure": false
        }
    },
    "extra": {
        "symfony-web-dir": "web",
        "incenteev-parameters": {
            "file": "config/parameters.yaml"
        }
    }
}
