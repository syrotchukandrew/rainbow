{
    "name": "acer/rainbow",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": { "App\\": "src/App/" },
        "classmap": ["src/Kernel.php"]
    },
    "require": {
        "php": ">=8.4",
        "symfony/asset": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/intl": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/password-hasher": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/security-http": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bridge": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/var-dumper": "^8.0",
        "symfony/yaml": "^8.0",
        "doctrine/orm": "^3.4",
        "doctrine/doctrine-bundle": "^3.0",
        "symfony/monolog-bundle": "^4.0",
        "hwi/oauth-bundle":                  "^2.0",
        "stof/doctrine-extensions-bundle":   "^1.12",
        "knplabs/knp-paginator-bundle":      "^6.0",
        "liip/imagine-bundle":               "^2.6",
        "knplabs/knp-snappy-bundle":         "^1.9",
        "knplabs/knp-snappy":                "^1.4",
        "h4cc/wkhtmltopdf-amd64":            "^0.12.3",
        "huluti/breadcrumbs-bundle":          "^1.7",
        "friendsofsymfony/jsrouting-bundle": "^3.5",
        "masterminds/html5": "^2.10",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/dotenv": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/rate-limiter": "^8.0"
    },
    "require-dev": {
        "symfony/phpunit-bridge":            "^8.0",
        "symfony/debug-bundle":              "^8.0",
        "symfony/web-profiler-bundle":       "^8.0",
        "symfony/browser-kit":               "^8.0",
        "symfony/css-selector":              "^8.0",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "phpunit/phpunit":                   "^10.5",
        "fakerphp/faker":                    "^1.20"
    },
    "config": {
        "bin-dir": "bin",
        "platform": {
            "php": "8.4.0"
        },
        "audit": {
            "abandoned": "ignore",
            "block-insecure": false
        },
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "extra": {
    }
}
